generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String               @id
  email       String               @unique
  authUserId  String?              @unique
  fullName    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  role        String?
  disabled    Boolean              @default(false)
  lastLogin   DateTime?
  memberships OrganizationMember[]
}

model AuthEmailToken {
  id                   String    @id @default(uuid())
  tokenHash            String    @unique
  purpose              String
  email                String
  authUserId           String
  organizationMemberId String?
  requiresPassword     Boolean   @default(false)
  expiresAt            DateTime
  consumedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@index([email, purpose])
  @@index([authUserId, purpose])
  @@index([organizationMemberId])
  @@index([purpose, consumedAt, expiresAt])
  @@index([expiresAt])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           String
  status         String       @default("pending")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}

model Organization {
  id                     String                 @id @default(uuid())
  name                   String
  domains                String[]
  ownerEmail             String?
  status                 String                 @default("pending")
  /// Periodic WAF summary emails: daily | weekly | monthly | hourly
  summaryReportFrequency String                 @default("daily")
  summaryReportEnabled   Boolean                @default(false)
  summaryReportEmails    String[]               @default([])
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  logs                   Log[]
  members                OrganizationMember[]
  domainWafStatuses      DomainWAFStatus[]
  ipBans                 IPBan[]
  geoAccessControls      GeoAccessControl[]
  notificationSettings   NotificationSettings[]
}

model Log {
  id             String        @id @default(uuid())
  organizationId String?
  action         String
  severity       String
  timestamp      DateTime
  clientIp       String
  clientPort     Int?
  host           String
  method         String
  requestUrl     String
  rule           String?
  ruleId         String?
  userAgent      String?
  headers        Json?
  message        String?
  httpMethod     String?
  responseHeader Json?
  responseCode   Int?
  maturity       Int?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, timestamp, clientIp, severity])
  @@index([timestamp])
  @@index([clientIp])
  @@index([action])
  @@index([severity])
  @@index([host])
}

model DomainWAFStatus {
  id             String       @id @default(uuid())
  organizationId String
  domain         String
  wafEnabled     Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
}

model ModsecLanding {
  id         BigInt   @id @default(autoincrement()) @map("id")
  tag        String?  @map("tag")
  time       DateTime @default(now()) @map("time") @db.Timestamp(6)
  data       Json     @map("data")
  processed  Boolean? @default(false) @map("processed")
  /// Normalized request host maintained by a database trigger.
  sourceHost String?  @map("source_host")

  @@index([processed])
  @@index([time])
  @@index([tag])
  // The processed=false (source_host, time) and (id) partial indexes are
  // migration-managed because Prisma cannot represent partial predicates.
  @@map("modsec_landing")
}

model IPBan {
  id             String       @id @default(uuid())
  organizationId String
  ip             String
  domains        String[] // Array of domains, or ["*"] for all domains
  country        String? // ISO country code (e.g., "US", "GB")
  countryName    String? // Full country name
  reason         String? // Reason for ban
  bannedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ip])
  @@index([organizationId])
  @@index([ip])
  @@index([bannedAt])
}

model IPBanToken {
  id             String    @id @default(uuid())
  organizationId String
  ip             String
  domains        String[] // Array of domains to ban
  token          String    @unique // Temporary token for one-time use
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([token])
  @@index([organizationId])
  @@index([expiresAt])
}

model GeoAccessControl {
  id               String       @id @default(uuid())
  organizationId   String
  domain           String // Domain name or "*" for all domains
  mode             String       @default("allow-all") // "allow-all" | "allow-only" | "ban-specific"
  allowedCountries String[]     @default([]) // ISO-3166-1 alpha-2 country codes
  deniedCountries  String[]     @default([]) // ISO-3166-1 alpha-2 country codes
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, domain])
  @@index([organizationId])
  @@index([domain])
}

model NotificationSettings {
  id                  String       @id @default(uuid())
  organizationId      String
  notificationType    String // "email" | "telegram"
  emailList           String[]     @default([]) // Array of email addresses
  telegramChatId      String? // Telegram chat ID
  telegramUserId      String? // Telegram user ID
  telegramEnabled     Boolean      @default(false) // Whether telegram is linked and active
  telegramConnectedAt DateTime? // When telegram was connected
  domainFilter        String       @default("all") // "all" | "specific"
  selectedDomains     String[]     @default([]) // Array of domain names (empty if domainFilter is "all")
  severityFilter      String       @default("all") // "all" | "critical" | "high" | "low"
  enabled             Boolean      @default(true) // Whether notifications are enabled
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([notificationType])
  @@index([enabled])
}

model TelegramConnectRequest {
  id             String    @id @default(uuid())
  userId         String // User who initiated the connect
  organizationId String // Which org to connect Telegram for
  connectCode    String    @unique // e.g. "EAG-482193"
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([connectCode])
  @@index([userId])
}
