{
  "name": "modsecurity-back-end",
  "version": "1.0.0",
  "description": "ModSecurity Backend API with Swagger documentation",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:logs": "tsx prisma/seed-logs.ts",
    "process:modsec": "tsx src/scripts/processModsecLanding.ts",
    "cron:modsec": "tsx src/scripts/processModsecCron.ts",
    "worker:modsec": "tsx src/workers/modsecProcessorWorker.ts",
    "check:modsec": "tsx src/scripts/checkModsecLanding.ts",
    "check:tables": "tsx src/scripts/checkTables.ts",
    "test:severity": "tsx src/services/__tests__/severityEnrichment.test.ts",
    "test:auth-email": "tsx src/services/__tests__/authEmailInfrastructure.test.ts",
    "test:agent-policy": "tsx --test src/services/__tests__/agentCredentialPolicy.test.ts",
    "test:host-filter": "tsx --test src/services/__tests__/logHostFilter.test.ts",
    "test:email-delivery": "tsx src/scripts/testEmailDeliveryMailTm.ts",
    "test:email-routes": "tsx src/scripts/testEmailRoutesMailTm.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "modsecurity",
    "api",
    "swagger",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@supabase/supabase-js": "^2.39.3",
    "@types/geoip-lite": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "geoip-lite": "^1.4.10",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.23",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
