# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/modsec?schema=public"
DIRECT_URL="postgresql://postgres:replace-me@localhost:5432/modsec?schema=public"

# -----------------------------------------------------------------------------
# Supabase Auth (required for identity/session management only)
# The backend does not use Supabase to deliver verification, invitation, or
# password-reset emails. Transactional delivery is configured under SMTP below.
# Never expose the service-role key to the browser.
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="replace-with-your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# -----------------------------------------------------------------------------
# Backend server and application URLs
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT="3001"
FRONTEND_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"
PUBLIC_BASE_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Transactional email (required for all backend email communication)
# Use SMTP_SECURE=true for implicit TLS (normally port 465). Use false for
# STARTTLS submission (normally port 587). SMTP_REQUIRE_TLS defaults to true;
# only disable it for a trusted local development mail catcher.
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER="replace-with-smtp-username"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="no-reply@example.com"
SMTP_FROM_NAME="Zergaw Cloud Firewall"

# Deprecated sender-address fallback. Prefer SMTP_FROM for new deployments.
# EMAIL_FROM="no-reply@example.com"

# -----------------------------------------------------------------------------
# Custom verification/reset/invitation token lifetimes
# -----------------------------------------------------------------------------
PASSWORD_RESET_TOKEN_TTL_MINUTES="60"
INVITATION_TOKEN_TTL_HOURS="72"

# -----------------------------------------------------------------------------
# Initial super-admin seed (required only when running `npm run seed`)
# ADMIN_ID is optional. Existing local users always retain their current ID.
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"
ADMIN_FULL_NAME="Super Admin"
# ADMIN_ID="00000000-0000-0000-0000-000000000001"

# -----------------------------------------------------------------------------
# WAF/Geo agent integration
# GEO_* values default to their WAF_* equivalents when omitted.
#
# Credentials are required based on WHERE the agent runs:
#
#   Local agent  -> WAF_AGENT_AUTH_TOKEN and WAF_AGENT_PRIVATE_KEY are OPTIONAL.
#                   Applies to localhost, 127.0.0.1, ::1, 10.x, 172.16-31.x,
#                   192.168.x, 169.254.x, 100.64-127.x, a Docker/Kubernetes
#                   service name, or a .local/.internal/.home.arpa host.
#                   Traffic never leaves the trusted network, so the backend
#                   talks to the agent unauthenticated.
#
#   Remote agent -> BOTH are REQUIRED. Applies to any public IP or public
#                   domain. Calls fail fast with a clear error rather than
#                   sending unsigned requests over the internet.
#
# Credentials are always used when set, local or not — configuring them on a
# local agent simply keeps requests authenticated.
# -----------------------------------------------------------------------------
WAF_AGENT_URL="http://localhost:8080"

# Required only when WAF_AGENT_URL is a public IP or domain.
# WAF_AGENT_AUTH_TOKEN="replace-with-a-long-random-token"
# WAF_AGENT_PRIVATE_KEY="replace-with-your-PEM-private-key"

# There is no flag to bypass this. An agent reached over WireGuard, Tailscale,
# or an SSH forward is addressed by its private endpoint (10.x, 100.64.x, or
# localhost:PORT), so it already counts as local. If the URL is public, set the
# credentials or point the URL at the agent's private address.

# Optional geo overrides; the WAF_* values above are used when omitted.
# The geo endpoints are token-only — they are not signature-protected.
# GEO_AGENT_URL="http://localhost:8080"
# GEO_AGENT_AUTH_TOKEN="replace-with-a-long-random-token"

# DEFAULT_ORGANIZATION_ID="00000000-0000-0000-0000-000000000000"

# -----------------------------------------------------------------------------
# Background processing
# -----------------------------------------------------------------------------
ENABLE_MODSEC_CRON="true"
MODSEC_CRON_SCHEDULE="*/5 * * * *"
BATCH_SIZE="100"

ENABLE_SUMMARY_REPORT_CRON="true"
SUMMARY_REPORT_CRON_SCHEDULE="0 * * * *"
# SUMMARY_REPORT_LOGO_PATH="C:/absolute/path/to/Logo-blue.png"

# -----------------------------------------------------------------------------
# Telegram integration (optional)
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN="replace-with-your-bot-token"
# TELEGRAM_BOT_USERNAME="your_bot_username"
# TELEGRAM_WEBHOOK_SECRET="replace-with-a-long-random-secret"
